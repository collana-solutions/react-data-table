{
  "name": "@collana-solutions/react-data-table",
  "version": "7.0.0",
  "description": "A small and clean data-table with a lot of integrated functions",
  "homepage": "https://collana-solutions.github.io/react-data-table",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collana-solutions/react-data-table"
  },
  "license": "MIT",
  "author": "collana solutions AG",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.modern.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "umd:main": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "unpkg": "dist/index.umd.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "jsnext:main": "dist/index.modern.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c && pnpm run copy-definitionfile",
    "build-storybook": "build-storybook",
    "lint": "eslint --cache",
    "prepack": "pnpm run build",
    "prepare-pr": "pnpm exec prettier . --write && pnpm run lint && pnpm run build && pnpm run test",
    "prettier-check": "prettier --check .",
    "prettier-write": "prettier --write .",
    "copy-definitionfile": "shx cp -r src/react-table.d.ts dist/react-table.d.ts",
    "start": "pnpm run copy-definitionfile && rollup -c -w",
    "start-all": "concurrently \"pnpm run start\" \"pnpm run start-yalc\"",
    "start-yalc": "nodemon --watch dist -x \"yalc push\"",
    "storybook": "start-storybook -p 6006",
    "test": "cross-env DEBUG_PRINT_LIMIT=100 jest",
    "tsc": "tsc",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@collana-solutions/javascript-utils": "^2.6.2",
    "@collana-solutions/react-pattern-ui": "^7.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.13.18",
    "react-loading-skeleton": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@collana-solutions/eslint-config": "^3.1.1",
    "@collana-solutions/reactstrap": "^10.0.2",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.2.8",
    "@storybook/react": "^10.2.8",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.7",
    "gh-pages": "^6.3.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "nodemon": "^3.1.11",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^4.57.1",
    "rollup-plugin-import-css": "^4.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.37.0",
    "shx": "^0.4.0",
    "ts-jest": "^29.4.6",
    "typescript": "^7.0.2",
    "webpack": "^5.105.2",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@collana-solutions/reactstrap": "^10.0.2",
    "@fortawesome/fontawesome-svg-core": "^6.1.1 || ^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.1.1 || ^7.2.0",
    "@fortawesome/react-fontawesome": "^0.1.18 || ^0.2.0 || ^3.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0"
}
